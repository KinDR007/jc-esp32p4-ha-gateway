   "precision": 1,
   "unit": "V",
   "class": "voltage",
   "state": "measurement"
  },
  {
   "key": "current",
   "name": "Current",
   "name_cs": "Proud",
   "reg": "input",
   "addr": "0x0006",
   "type": "f32",
   "precision": 2,
   "unit": "A",
   "class": "current",
   "state": "measurement"
  },
  {
   "key": "power",
   "name": "Power",
   "name_cs": "Výkon",
   "reg": "input",
   "addr": "0x000c",
   "type": "f32",
   "precision": 0,
   "unit": "W",
   "class": "power",
   "state": "measurement"
  },
  {
   "key": "apparent_power",
   "name": "Apparent power",
   "name_cs": "Zdánlivý výkon",
   "reg": "input",
   "addr": "0x0012",
   "type": "f32",
   "precision": 0,
   "unit": "VA",
   "class": "apparent_power",
   "state": "measurement"
  },
  {
   "key": "reactive_power",
   "name": "Reactive power",
   "name_cs": "Jalový výkon",
