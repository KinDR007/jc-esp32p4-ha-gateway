diff -ruN src/port/esp_openthread_radio_spinel.cpp
--- src/port/esp_openthread_radio_spinel.cpp
+++ src/port/esp_openthread_radio_spinel.cpp
@@ -220,6 +220,17 @@
     s_radio.Set(SPINEL_PROP_VENDOR_ESP_SET_CONSOLE_CMD, SPINEL_DATATYPE_DATA_WLEN_S, input, strlen(input));
 }
 
+extern "C" esp_err_t esp_openthread_rcp_get_vendor_data(uint32_t key, uint8_t *buf, size_t *len)
+{
+    /* Get() unpacks in place: the value is copied into buf, size is its capacity in and the length out. */
+    spinel_size_t size = *len;
+    if (s_radio.Get(static_cast<spinel_prop_key_t>(key), SPINEL_DATATYPE_DATA_S, buf, &size) != OT_ERROR_NONE) {
+        return ESP_FAIL;
+    }
+    *len = size;
+    return ESP_OK;
+}
