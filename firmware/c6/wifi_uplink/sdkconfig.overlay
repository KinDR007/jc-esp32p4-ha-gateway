# Wi-Fi uplink of the gateway (docs/wifi-uplink.md): ESP-Hosted co-processor, Wi-Fi station and
# access point (setup portal), no Bluetooth, to the P4 over UART on the pads the radio is wired with.
CONFIG_EH_TRANSPORT_CP_UART=y
CONFIG_EH_TRANSPORT_CP_UART_PORT=1
CONFIG_EH_TRANSPORT_CP_UART_BAUDRATE=921600
# UART1 drives the UART0 pads through the GPIO matrix: keep the console off them.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# IRAM: the UART ISR stays in IRAM, the ring buffer code moves to flash.
CONFIG_UART_ISR_IN_IRAM=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_BT_ENABLED=n
# Size: the image goes into a slot of the radio's slots layout
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=n
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
