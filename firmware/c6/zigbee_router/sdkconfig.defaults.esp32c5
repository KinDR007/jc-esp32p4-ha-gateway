# XIAO ESP32-C5: UART0 on GPIO11 (TX, D6) / GPIO12 (RX, D7), 8 MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_CONSOLE_UART_TX_GPIO=11
CONFIG_ESP_CONSOLE_UART_RX_GPIO=12
# PSRAM of the XIAO ESP32-C5 (8 MB): the large allocations of the Zigbee stack go there
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
